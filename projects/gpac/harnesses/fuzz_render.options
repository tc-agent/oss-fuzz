[libfuzzer]
# The GPAC filter session retains a small amount of long-lived state
# (~96 bytes across 2 allocations) when it is torn down after running
# a full remux pipeline. The state is owned by the session, not by an
# individual input, so libFuzzer's per-shutdown leak detector flags it
# on every exit and aborts the run. Disable leak detection here while
# the upstream cleanup gap is investigated; ASan still reports
# heap-buffer-overflows and other memory errors.
detect_leaks = 0
